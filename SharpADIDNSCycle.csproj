    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <StartupObject>SharpADIDNSCycle.Program</StartupObject>
    <Version>2.0.0</Version>
    <Authors>SenRan</Authors>
